<?xml version="1.0" encoding="utf-8"?>
<extension version="2.5.5" type="plugin" group="djmediatools" method="upgrade">
	<name>PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS</name>
	<creationDate>September 2021</creationDate>
    <author>DJ-Extensions.com</author>
	<copyright>Copyright (C) 2020 DJ-Extensions.com, All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses GNU/GPL</license>
	<authorEmail>contact@dj-extensions.com</authorEmail>
	<authorUrl>http://dj-extensions.com</authorUrl>
	<version>2.17.6</version>
	<description>PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_DESCRIPTION</description>
	<files>
		<filename plugin="djcatalog2producers">djcatalog2producers.php</filename>
		<filename>index.html</filename>
		<filename>icon.png</filename>
		<folder>language</folder>
	</files>

	<config>
		<fields name="params">

			<fieldset name="source_settings" addfieldpath="/administrator/components/com_djcatalog2/models/fields">

				<field name="plg_catalog2producers_catid" type="djcproducercategory" default="0" parent="false"
					label="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_CATEGORIESSWITCH" description="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_CATEGORIESSWITCH_DESC" multiple="true" size="10"/>

				<field name="plg_catalog2producers_item_ids" type="textarea" default="" label="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_ITEM_IDS" description="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_ITEM_IDS_DESC" />

				<field name="plg_catalog2producers_orderby" type="list" default="0" label="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_ORDERBY">
					<option value="i.ordering">PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_DEFAULTORDER</option>
					<option value="a.name">PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_NAME</option>
				</field>

				<field name="plg_catalog2producers_orderdir" type="list" default="0" label="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_ORDERDIR">
					<option value="asc">PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_ASC</option>
					<option value="desc">PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_DESC</option>
				</field>

				<field name="plg_catalog2producers_display_preview" type="list" default="0" label="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_DISPLAY_PREVIEW" >
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>

				<field name="plg_catalog2producers_image" type="media" label="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_DEFAULT_IMAGE" description="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_DEFAULT_IMAGE_DESC" />


				<field name="plg_catalog2producers_linktype" type="list" default="0" label="PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_LINKTYPE">
					<option value="profile">PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_LINKTYPE_PROFILE</option>
					<option value="items">PLG_DJMEDIATOOLS_DJCATALOG2PRODUCERS_LINKTYPE_ITEMS</option>

				</field>

			</fieldset>

		</fields>
	</config>

</extension>
