    ADD COLUMN IF NOT EXISTS `two_months_ago` INT NOT NULL DEFAULT 0 AFTER `last_month`,
    ADD COLUMN IF NOT EXISTS `three_months_ago` INT NOT NULL DEFAULT 0 AFTER `two_months_ago`,
    ADD COLUMN IF NOT EXISTS `four_months_ago` INT NOT NULL DEFAULT 0 AFTER `three_months_ago`,
    ADD COLUMN IF NOT EXISTS `five_months_ago` INT NOT NULL DEFAULT 0 AFTER `four_months_ago`,
    ADD COLUMN IF NOT EXISTS `last_year` INT NOT NULL DEFAULT 0 AFTER `this_year`;